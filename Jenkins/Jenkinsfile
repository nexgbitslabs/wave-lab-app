pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_NAME  = 'wave-lab-app'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Tooling') {
            steps {
                sh '''
                    set -e

                    echo "========================================"
                    echo "Wave Lab - CI Tooling Verification"
                    echo "========================================"

                    echo ""
                    echo "Git:"
                    git --version

                    echo ""
                    echo "Docker:"
                    docker --version

                    echo ""
                    echo "Application:"
                    echo "${APP_NAME}"

                    echo ""
                    echo "Image tag:"
                    echo "${IMAGE_TAG}"
                '''
            }
        }

        stage('Build Container Image') {
            steps {
                sh '''
                    set -e

                    echo "Building ${APP_NAME}:${IMAGE_TAG}"

                    docker build \
                      -t "${APP_NAME}:${IMAGE_TAG}" \
                      .

                    echo ""
                    echo "Container image built successfully."

                    docker image inspect \
                      "${APP_NAME}:${IMAGE_TAG}" \
                      --format='{{.RepoTags}}'
                '''
            }
        }

        stage('Push Container Image to ACR') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'azure-terraform-client-id',
                        variable: 'ARM_CLIENT_ID'
                    ),
                    string(
                        credentialsId: 'azure-terraform-client-secret',
                        variable: 'ARM_CLIENT_SECRET'
                    ),
                    string(
                        credentialsId: 'azure-terraform-tenant-id',
                        variable: 'ARM_TENANT_ID'
                    )
                ]) {
                    sh '''
                        set -e

                        ACR_NAME="acrwavelabdev"
                        ACR_LOGIN_SERVER="acrwavelabdev.azurecr.io"

                        LOCAL_IMAGE="${APP_NAME}:${IMAGE_TAG}"
                        REMOTE_IMAGE="${ACR_LOGIN_SERVER}/${APP_NAME}:${IMAGE_TAG}"

                        echo "========================================"
                        echo "Push Container Image to ACR"
                        echo "========================================"

                        echo ""
                        echo "Authenticating Jenkins service principal to Azure..."

                        az login \
                          --service-principal \
                          --username "$ARM_CLIENT_ID" \
                          --password "$ARM_CLIENT_SECRET" \
                          --tenant "$ARM_TENANT_ID" \
                          --output none

                        echo ""
                        echo "Authenticating Docker to ${ACR_LOGIN_SERVER}..."

                        az acr login \
                          --name "$ACR_NAME"

                        echo ""
                        echo "Tagging image:"
                        echo "${LOCAL_IMAGE} -> ${REMOTE_IMAGE}"

                        docker tag \
                          "${LOCAL_IMAGE}" \
                          "${REMOTE_IMAGE}"

                        echo ""
                        echo "Pushing ${REMOTE_IMAGE}..."

                        docker push \
                          "${REMOTE_IMAGE}"

                        echo ""
                        echo "Container image pushed successfully:"
                        echo "${REMOTE_IMAGE}"

                        az logout
                    '''
                }
            }
        }

        stage('Update GitOps Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-wave-lab-gitops',
                        usernameVariable: 'GITOPS_USERNAME',
                        passwordVariable: 'GITOPS_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        GITOPS_REPO="https://github.com/nexgbitslabs/wave-lab-gitops.git"
                        GITOPS_DIR="${WORKSPACE}/wave-lab-gitops"

                        DEPLOYMENT_FILE="apps/base/deployment.yaml"

                        ACR_LOGIN_SERVER="acrwavelabdev.azurecr.io"
                        NEW_IMAGE="${ACR_LOGIN_SERVER}/${APP_NAME}:${IMAGE_TAG}"

                        echo "========================================"
                        echo "Update GitOps Image"
                        echo "========================================"

                        echo ""
                        echo "Target image:"
                        echo "${NEW_IMAGE}"

                        echo ""
                        echo "Cleaning previous GitOps workspace..."

                        rm -rf "${GITOPS_DIR}"

                        echo ""
                        echo "Cloning GitOps repository..."

                        git clone \
                          "${GITOPS_REPO}" \
                          "${GITOPS_DIR}"

                        cd "${GITOPS_DIR}"

                        echo ""
                        echo "Current image:"
                        grep "image:" "${DEPLOYMENT_FILE}"

                        echo ""
                        echo "Updating image..."

                        sed -i \
                          "s|image: .*|image: ${NEW_IMAGE}|" \
                          "${DEPLOYMENT_FILE}"

                        echo ""
                        echo "New image:"
                        grep "image:" "${DEPLOYMENT_FILE}"

                        git config \
                          user.name \
                          "Wave Lab Jenkins"

                        git config \
                          user.email \
                          "jenkins@wave-lab.local"

                        git add \
                          "${DEPLOYMENT_FILE}"

                        if git diff --cached --quiet; then

                            echo ""
                            echo "No GitOps change required."
                            echo "Repository already references:"
                            echo "${NEW_IMAGE}"

                        else

                            echo ""
                            echo "Creating GitOps commit..."

                            git commit \
                              -m "Deploy ${APP_NAME}:${IMAGE_TAG} to DEV"

                            echo ""
                            echo "Pushing GitOps change..."

                            git push \
                              "https://${GITOPS_USERNAME}:${GITOPS_TOKEN}@github.com/nexgbitslabs/wave-lab-gitops.git" \
                              HEAD:main

                            echo ""
                            echo "GitOps update pushed successfully."

                        fi
                    '''
                }
            }
        }
    }

    post {

        success {
            echo "Jenkins CI build completed successfully."
        }

        failure {
            echo "Jenkins CI build failed."
        }

        always {
            echo "Build: ${BUILD_NUMBER}"
        }
    }
}