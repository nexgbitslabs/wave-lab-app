pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_NAME     = 'wave-lab-app'
        IMAGE_TAG    = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Tooling') {
            steps {
                sh '''
                    set -e

                    echo "========================================"
                    echo "Wave Lab - CI Tooling Verification"
                    echo "========================================"

                    echo ""
                    echo "Git:"
                    git --version

                    echo ""
                    echo "Docker:"
                    docker --version

                    echo ""
                    echo "Application:"
                    echo "${APP_NAME}"

                    echo ""
                    echo "Image tag:"
                    echo "${IMAGE_TAG}"
                '''
            }
        }

        stage('Build Container Image') {
            steps {
                sh '''
                    set -e

                    echo "Building ${APP_NAME}:${IMAGE_TAG}"

                    docker build \
                      -t ${APP_NAME}:${IMAGE_TAG} \
                      .

                    echo ""
                    echo "Container image built successfully."

                    docker image inspect \
                      ${APP_NAME}:${IMAGE_TAG} \
                      --format='{{.RepoTags}}'
                '''
            }
        }

        stage('Verify ACR Authentication') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'azure-terraform-client-id',
                        variable: 'ARM_CLIENT_ID'
                    ),
                    string(
                        credentialsId: 'azure-terraform-client-secret',
                        variable: 'ARM_CLIENT_SECRET'
                    ),
                    string(
                        credentialsId: 'azure-terraform-tenant-id',
                        variable: 'ARM_TENANT_ID'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "Authenticating Jenkins service principal to Azure..."

                        az login \
                        --service-principal \
                        --username "$ARM_CLIENT_ID" \
                        --password "$ARM_CLIENT_SECRET" \
                        --tenant "$ARM_TENANT_ID" \
                        --output none

                        echo "Authenticating Docker to ACR..."

                        az acr login --name acrwavelabdev

                        echo "ACR authentication successful."

                        az logout
                    '''
                }
            }
        }

        stage('Push Container Image to ACR') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'azure-terraform-client-id',
                        variable: 'ARM_CLIENT_ID'
                    ),
                    string(
                        credentialsId: 'azure-terraform-client-secret',
                        variable: 'ARM_CLIENT_SECRET'
                    ),
                    string(
                        credentialsId: 'azure-terraform-tenant-id',
                        variable: 'ARM_TENANT_ID'
                    )
                ]) {
                    sh '''
                        set -e

                        ACR_NAME="acrwavelabdev"
                        ACR_LOGIN_SERVER="acrwavelabdev.azurecr.io"
                        LOCAL_IMAGE="${APP_NAME}:${IMAGE_TAG}"
                        REMOTE_IMAGE="${ACR_LOGIN_SERVER}/${APP_NAME}:${IMAGE_TAG}"

                        echo "Authenticating Jenkins service principal to Azure..."

                        az login \
                        --service-principal \
                        --username "$ARM_CLIENT_ID" \
                        --password "$ARM_CLIENT_SECRET" \
                        --tenant "$ARM_TENANT_ID" \
                        --output none

                        echo "Authenticating Docker to ${ACR_LOGIN_SERVER}..."

                        az acr login --name "$ACR_NAME"

                        echo "Tagging image:"
                        echo "${LOCAL_IMAGE} -> ${REMOTE_IMAGE}"

                        docker tag \
                        "${LOCAL_IMAGE}" \
                        "${REMOTE_IMAGE}"

                        echo "Pushing ${REMOTE_IMAGE}..."

                        docker push "${REMOTE_IMAGE}"

                        echo ""
                        echo "Container image pushed successfully:"
                        echo "${REMOTE_IMAGE}"

                        az logout
                    '''
                }
            }
        }

        stage('Update GitOps Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-wave-lab-gitops',
                        usernameVariable: 'GITOPS_USERNAME',
                        passwordVariable: 'GITOPS_TOKEN'
                    )
                ]) {
            sh '''
                set -e

                GITOPS_REPO="https://github.com/nexgbitslabs/wave-lab-gitops.git"
                GITOPS_DIR="${WORKSPACE}/wave-lab-gitops"
                DEPLOYMENT_FILE="apps/base/deployment.yaml"
                NEW_IMAGE="acrwavelabdev.azurecr.io/${APP_NAME}:${IMAGE_TAG}"

                echo "========================================"
                echo "Updating GitOps repository"
                echo "========================================"
                echo "Image: ${NEW_IMAGE}"

                rm -rf "${GITOPS_DIR}"

                GIT_ASKPASS_SCRIPT=$(mktemp)

                cat > "$GIT_ASKPASS_SCRIPT" <<'SCRIPT'
                #!/bin/sh
                case "$1" in
                    *Username*) echo "$GITOPS_USERNAME" ;;
                    *Password*) echo "$GITOPS_TOKEN" ;;
                esac
                SCRIPT

                                chmod 700 "$GIT_ASKPASS_SCRIPT"

                                export GIT_ASKPASS="$GIT_ASKPASS_SCRIPT"
                                export GIT_TERMINAL_PROMPT=0

                                git clone "${GITOPS_REPO}" "${GITOPS_DIR}"

                                cd "${GITOPS_DIR}"

                                echo "Current image:"
                                grep "image:" "${DEPLOYMENT_FILE}"

                                sed -i \
                                "s|image: .*|image: ${NEW_IMAGE}|" \
                                "${DEPLOYMENT_FILE}"

                                echo "New image:"
                                grep "image:" "${DEPLOYMENT_FILE}"

                                git config user.name "Wave Lab Jenkins"
                                git config user.email "jenkins@wave-lab.local"

                                git add "${DEPLOYMENT_FILE}"

                                if git diff --cached --quiet; then
                                    echo "GitOps repository already references ${NEW_IMAGE}."
                                else
                                    git commit \
                                    -m "Deploy ${APP_NAME}:${IMAGE_TAG} to DEV"

                                    git push origin main

                                    echo "GitOps update pushed successfully."
                                fi

                                rm -f "$GIT_ASKPASS_SCRIPT"
                            '''
                        }
                    }
                }

        stage('Verify GitOps Repository Access') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-wave-lab-gitops',
                        usernameVariable: 'GITOPS_USERNAME',
                        passwordVariable: 'GITOPS_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "Verifying GitOps repository access..."

                        GIT_ASKPASS_SCRIPT=$(mktemp)

                        cat > "$GIT_ASKPASS_SCRIPT" <<'SCRIPT'
        #!/bin/sh
        case "$1" in
            *Username*) echo "$GITOPS_USERNAME" ;;
            *Password*) echo "$GITOPS_TOKEN" ;;
        esac
        SCRIPT

                        chmod 700 "$GIT_ASKPASS_SCRIPT"

                        GIT_ASKPASS="$GIT_ASKPASS_SCRIPT" \
                        GIT_TERMINAL_PROMPT=0 \
                        git ls-remote \
                        https://github.com/nexgbitslabs/wave-lab-gitops.git \
                        refs/heads/main

                        rm -f "$GIT_ASKPASS_SCRIPT"

                        echo "GitOps repository authentication successful."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Jenkins CI build completed successfully."
        }

        failure {
            echo "Jenkins CI build failed."
        }

        always {
            echo "Build: ${BUILD_NUMBER}"
        }
    }
}
